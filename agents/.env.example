# Provider per agent role: "<provider>:<model id>". Providers: bedrock | anthropic | openai | ollama | fake
# HEYGILLI_MODEL_DEFAULT covers any role left unset.
#
# Bedrock ids verified in us-east-1 on 2026-09-05 with `aws bedrock-runtime converse`:
#   us.anthropic.claude-sonnet-4-6                 -> ResourceNotFoundException "Model use case details have
#   us.anthropic.claude-haiku-4-5-20251001-v1:0       not been submitted for this account" (Anthropic use-case
#                                                     form pending; haiku answered once, then was gated too)
#   us.anthropic.claude-opus-4-8                   -> AccessDeniedException "not available for this account"
#   us.amazon.nova-pro-v1:0 / us.amazon.nova-lite-v1:0 -> OK (structured output + tools work through Strands)
# Once the Anthropic form is approved the four lines below are the intended defaults (SPEC 9.5).
HEYGILLI_MODEL_CURATOR=bedrock:us.anthropic.claude-sonnet-4-6
HEYGILLI_MODEL_PLANNER=bedrock:us.anthropic.claude-sonnet-4-6
HEYGILLI_MODEL_BUDDY=bedrock:us.anthropic.claude-haiku-4-5-20251001-v1:0
HEYGILLI_MODEL_DIGEST=bedrock:us.anthropic.claude-sonnet-4-6
# Key-free Bedrock fallback that works today (used for the 2026-09-05 live smoke):
# HEYGILLI_MODEL_DEFAULT=bedrock:us.amazon.nova-pro-v1:0
# Offline / tests:
# HEYGILLI_MODEL_DEFAULT=fake:
# Local, no keys:  uv pip install -e ".[ollama]"
# HEYGILLI_MODEL_DEFAULT=ollama:llama3.2:3b

AWS_REGION=us-east-1                 # Bedrock inference profiles and Polly live here, not ap-southeast-1
HEYGILLI_BEDROCK_REGION=us-east-1
HEYGILLI_POLLY_REGION=us-east-1
HEYGILLI_POLLY_VOICE=Ivy             # neural child voice, verified in us-east-1 (Kevin is the boy voice)
# HEYGILLI_TTS=off                   # skip Polly; client speaks on device
HEYGILLI_STORE=local                 # local | dynamo (HEYGILLI_DYNAMO_TABLE=heygilli)
# HEYGILLI_DATA_DIR=./.data          # JSON store + cached TTS mp3s for HEYGILLI_STORE=local
HEYGILLI_SECRET=dev-secret-change-me # signs the /auth/dev bearer tokens
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=                    # only the get_transcript tool (YouTube URL -> transcript); needs .[gemini]
