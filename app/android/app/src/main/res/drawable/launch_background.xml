<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by Android before Flutter draws its first frame. Cream ground and
     Gilli centred, so the handover into the Dart splash is invisible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/gilli_cream" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_gilli" />
    </item>
</layer-list>
