PROJECT_NAME=heygilli
APP_DIR=app
STACK=flutter
BUILD_CMD="flutter build web"
# Web dev server. Chrome is fine too (`flutter run -d chrome`), but a fixed
# port is what the shared run workflow watches for.
DEV_CMD="flutter run -d web-server --web-hostname 127.0.0.1 --web-port 5601 --dart-define=HEYGILLI_API_URL=http://localhost:8080"
DEV_URL="http://localhost:5601"
# Both halves. The client suite alone has been green while the seam to the
# gateway was broken, so a "tests pass" that skipped the backend would be a
# lie of exactly the kind this project has already shipped once.
TEST_CMD="flutter test && (cd ../agents && uv run pytest -q)"
WEB_DEPLOY_CMD="flutter build web"
IOS_DIR="ios"
IOS_LANE="beta"
ANDROID_DIR="android"
ANDROID_LANE="beta"

# ── The gateway the client talks to ────────────────────────────────────────
# Nothing in the app works without it. FastAPI + Strands agents, port 8080.
#   cd agents && uv run python -m uvicorn heygilli_agents.gateway:app --port 8080
# Health: GET /healthz. State: agents/.data (JSON store, gitignored).
BACKEND_DIR="agents"
BACKEND_CMD="uv run python -m uvicorn heygilli_agents.gateway:app --port 8080"
BACKEND_URL="http://localhost:8080"
BACKEND_TEST_CMD="uv run pytest -q && uv run ruff check ."

# ── Defines every real build needs ─────────────────────────────────────────
# HEYGILLI_API_URL, not ..._BASE_URL: the second is read by nothing and a
# build with it silently talks to the emulator default instead.
# The client id is the *web* OAuth client, from agents/.env — Android needs it
# as serverClientId before Google will issue a server auth code at all. Without
# it the Google button renders and does nothing.
#   --dart-define=HEYGILLI_API_URL=...
#   --dart-define=HEYGILLI_GOOGLE_SERVER_CLIENT_ID=<web client id>
# Android emulator reaches the host at 10.0.2.2; iOS simulator and web use
# localhost. That is the default now, per platform, so the define is only for
# a real device or a deployed gateway.
ANDROID_DART_DEFINES="--dart-define=HEYGILLI_API_URL=http://10.0.2.2:8080"
IOS_DART_DEFINES="--dart-define=HEYGILLI_API_URL=http://localhost:8080"

# Demo mode ships canned data and no network. It is opt-in at build time only:
# an unreachable gateway is an error a parent can see, never a silent swap to
# invented children.
DEMO_DEFINE="--dart-define=HEYGILLI_DEMO=true"
